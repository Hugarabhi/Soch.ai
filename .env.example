# ============================================================
# Soch.ai environment variables (template)
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------
DATABASE_URL=postgresql://soch:soch@localhost:5432/soch
DATABASE_URL_REPLICA_READ=postgresql://soch:soch@localhost:5432/soch_replica

# ------------------------------------------------------------
# Redis (queues, cache, vector-backed session state)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Auth — Clerk (managed authN; webhook syncs users to backend)
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx

# ------------------------------------------------------------
# Backend → AI service
# ------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8300
AI_SERVICE_API_KEY=change-me-ai-gateway-key

# ------------------------------------------------------------
# AI providers
# LOCAL_LLM_BASE_URL must point at the Ollama gateway endpoint.
# HELPED llm.routing: high-priority generation -> hosted, batch -> local.
# ------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:70b
LOCAL_SMALL_MODEL=qwen2.5:14b / deepseek-r1:32b
EMBEDDING_MODEL=bge-m3

# Optional hosted providers (used when LOCAL_LLM is over capacity or for eval)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------
# Search APIs
# ------------------------------------------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=          # optional alternative

# ------------------------------------------------------------
# Vector DB (Qdrant)
# ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------
# Storage — Supabase S3-compatible
# ------------------------------------------------------------
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_BUCKET=soch-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------
# Feature flags / experimentation
# ------------------------------------------------------------
POSTHOG_KEY=
STRIPE_SECRET_KEY=       # future: monetization